#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba8) readonly uniform image2D input_rgba8;
layout(set = 0, binding = 1, rgba8) writeonly uniform image2D output_rgba8;
layout(set = 0, binding = 2, rgba16f) readonly uniform image2D input_rgba16f;
layout(set = 0, binding = 3, rgba16f) writeonly uniform image2D output_rgba16f;

layout(push_constant) uniform EffectConstants {
  uint effect_kind;
  uint pass_index;
  uint pass_count;
  uint quality;
  float amount;
  float radius;
  float angle;
  uint format_kind;
  uint seed_lo;
  uint seed_hi;
} pc;

vec4 read_pixel(ivec2 p, ivec2 size) {
  p = clamp(p, ivec2(0), size - ivec2(1));
  return pc.format_kind == 2u ? imageLoad(input_rgba16f, p)
                              : imageLoad(input_rgba8, p);
}

void write_pixel(ivec2 p, vec4 value) {
  if (pc.format_kind == 2u) imageStore(output_rgba16f, p, value);
  else imageStore(output_rgba8, p, value);
}

float hash21(vec2 p) {
  float seed = float((pc.seed_lo ^ pc.seed_hi) & 65535u) / 65535.0;
  return fract(sin(dot(p, vec2(127.1, 311.7)) + seed) * 43758.5453);
}

void main() {
  ivec2 size = pc.format_kind == 2u ? imageSize(output_rgba16f)
                                    : imageSize(output_rgba8);
  ivec2 p = ivec2(gl_GlobalInvocationID.xy);
  if (any(greaterThanEqual(p, size))) return;

  vec4 src = read_pixel(p, size);
  vec3 rgb = src.rgb;
  float amount = clamp(pc.amount, 0.0, 1.0);
  float radius = clamp(pc.radius, 0.0, 64.0);
  vec2 uv = (vec2(p) + 0.5) / vec2(size);
  vec2 centered = uv * 2.0 - 1.0;

  if (pc.effect_kind == 0u || pc.effect_kind == 2u || pc.effect_kind == 8u) {
    int step_size = max(1, int(round(radius * (pc.quality == 2u ? 0.5 : 0.25))));
    ivec2 axis = ivec2(step_size, 0);
    if (pc.effect_kind == 8u) {
      float radians = radians(pc.angle);
      axis = ivec2(round(cos(radians) * step_size), round(sin(radians) * step_size));
      if (axis == ivec2(0)) axis.x = 1;
    } else if (pc.pass_index > 0u) {
      axis = ivec2(0, step_size);
    }
    vec3 a = read_pixel(p - axis * 2, size).rgb;
    vec3 b = read_pixel(p - axis, size).rgb;
    vec3 d = read_pixel(p + axis, size).rgb;
    vec3 e = read_pixel(p + axis * 2, size).rgb;
    vec3 blurred = (a + b * 2.0 + src.rgb * 4.0 + d * 2.0 + e) / 10.0;
    if (pc.effect_kind == 2u) {
      vec3 highlights = max(blurred - 0.55, vec3(0.0)) * 2.2222222;
      rgb = mix(src.rgb, src.rgb + highlights, amount);
    } else {
      rgb = mix(src.rgb, blurred, amount);
    }
  } else if (pc.effect_kind == 1u) {
    vec3 n = read_pixel(p + ivec2(0, -1), size).rgb;
    vec3 s = read_pixel(p + ivec2(0, 1), size).rgb;
    vec3 w = read_pixel(p + ivec2(-1, 0), size).rgb;
    vec3 e = read_pixel(p + ivec2(1, 0), size).rgb;
    rgb = mix(src.rgb, src.rgb * 5.0 - n - s - w - e, amount);
  } else if (pc.effect_kind == 3u) {
    float r2 = dot(centered, centered);
    float scale = 1.0 + amount * 0.35 * r2;
    vec2 sample_uv = clamp((centered / scale + 1.0) * 0.5, 0.0, 1.0);
    ivec2 q = min(ivec2(sample_uv * vec2(size)), size - ivec2(1));
    rgb = read_pixel(q, size).rgb;
  } else if (pc.effect_kind == 4u || pc.effect_kind == 5u) {
    float grain = hash21(vec2(p)) - 0.5;
    if (pc.effect_kind == 5u) {
      float luma = dot(src.rgb, vec3(0.2126, 0.7152, 0.0722));
      grain *= 0.35 + 0.65 * (1.0 - abs(luma * 2.0 - 1.0));
    }
    rgb = src.rgb + grain * amount * (pc.effect_kind == 5u ? 0.16 : 0.25);
  } else if (pc.effect_kind == 6u) {
    int offset = max(1, int(round(1.0 + radius * 0.12)));
    float red = read_pixel(p + ivec2(offset, 0), size).r;
    float blue = read_pixel(p - ivec2(offset, 0), size).b;
    rgb = mix(src.rgb, vec3(red, src.g, blue), amount);
  } else if (pc.effect_kind == 7u) {
    float dist = length(centered * vec2(0.9, 1.0));
    float vignette = smoothstep(0.45, 1.15, dist);
    rgb = src.rgb * (1.0 - vignette * amount * 0.85);
  }

  write_pixel(p, vec4(max(rgb, vec3(0.0)), src.a));
}
