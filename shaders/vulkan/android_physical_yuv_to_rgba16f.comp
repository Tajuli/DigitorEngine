#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(set = 0, binding = 0) uniform sampler2D decodedFrame;
layout(rgba16f, set = 0, binding = 1) writeonly uniform image2D rgbaOutput;

void main() {
    ivec2 size = imageSize(rgbaOutput);
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= size.x || p.y >= size.y) return;
    vec2 uv = (vec2(p) + vec2(0.5)) / vec2(size);
    vec4 c = texture(decodedFrame, uv);
    imageStore(rgbaOutput, p, vec4(c.rgb, 1.0));
}
