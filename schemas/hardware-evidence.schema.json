{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitor.dev/schemas/hardware-evidence.schema.json",
  "title": "DigitorEngine Hardware Evidence Bundle",
  "type": "object",
  "required": ["engineVersion", "sourceCommit", "records"],
  "properties": {
    "engineVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "sourceCommit": {"type": "string", "minLength": 7},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "platform", "backend", "deviceId", "gpuName", "driverVersion",
          "evidenceSha256", "renderedFrames", "soakSeconds",
          "averageFrameMs", "p95FrameMs", "previewDigest", "exportDigest",
          "realDevice", "signedAttestation", "gpuExecutionObserved",
          "silentCpuFallbackObserved"
        ],
        "properties": {
          "platform": {"enum": ["windows", "android", "macos", "ios"]},
          "backend": {"enum": ["vulkan", "d3d12", "metal", "gles"]},
          "deviceId": {"type": "string", "minLength": 1},
          "gpuName": {"type": "string", "minLength": 1},
          "driverVersion": {"type": "string", "minLength": 1},
          "evidenceSha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
          "renderedFrames": {"type": "integer", "minimum": 1},
          "droppedFrames": {"type": "integer", "minimum": 0},
          "validationErrors": {"type": "integer", "minimum": 0},
          "deviceLossEvents": {"type": "integer", "minimum": 0},
          "soakSeconds": {"type": "integer", "minimum": 1},
          "averageFrameMs": {"type": "number", "exclusiveMinimum": 0},
          "p95FrameMs": {"type": "number", "exclusiveMinimum": 0},
          "previewDigest": {"type": "integer", "minimum": 1},
          "exportDigest": {"type": "integer", "minimum": 1},
          "realDevice": {"const": true},
          "signedAttestation": {"type": "boolean"},
          "gpuExecutionObserved": {"const": true},
          "silentCpuFallbackObserved": {"const": false}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
