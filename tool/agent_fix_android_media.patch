+      const auto diagnostic = decoder_.diagnostic();
+      throw std::runtime_error(
+          diagnostic.empty() ? "Android native MediaCodec seek failed"
+                             : diagnostic);
+    }
+    cache_.clear();
+    next_number_ = 0;
+  }
