{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DigitorEngine Release Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "abiMajor",
    "abiMinor",
    "commit",
    "compiledBackends",
    "previewExportParityRequired",
    "silentCpuFallbackForbidden"
  ],
  "properties": {
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "abiMajor": {"type": "integer", "minimum": 1},
    "abiMinor": {"type": "integer", "minimum": 0},
    "commit": {"type": "string", "minLength": 7},
    "compiledBackends": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["vulkan", "d3d12", "metal", "gles", "cpu"]}
    },
    "previewExportParityRequired": {"const": true},
    "silentCpuFallbackForbidden": {"const": true},
    "hardwareEvidence": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    }
  }
}
