#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(set = 0, binding = 0) uniform sampler2D decodedFrame;
layout(rgba16f, set = 0, binding = 1) writeonly uniform image2D rgbaOutput;

void main() {
    ivec2 size = imageSize(rgbaOutput);
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= size.x || pixel.y >= size.y) return;
    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(size);
    vec4 converted = texture(decodedFrame, uv);
    imageStore(rgbaOutput, pixel, vec4(converted.rgb, 1.0));
}
